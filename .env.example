# Resend API Key — get yours free at https://resend.com
# After signing up: Dashboard → API Keys → Create API Key
# Then add your domain or use the sandbox (onboarding@resend.dev works for testing)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anti-spam du formulaire (facultatif en local, recommandé en production)
# Upstash Redis — partage les compteurs entre les instances Vercel.
# L'intégration Upstash du Marketplace Vercel pose KV_REST_API_URL / KV_REST_API_TOKEN, reconnues aussi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile — la clé de site du portfolio est déjà dans le code.
# Clé secrète : tableau de bord Cloudflare → Turnstile → widget du portfolio → Settings.
# En local, si localhost n'est pas dans les domaines du widget, utiliser les clés de test :
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
